{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/gallery/(.*)\.mpeg",
      "headers": [
        { "key": "Content-Type", "value": "audio/mpeg" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    },
    {
      "source": "/gallery/(.*)\.mp3",
      "headers": [
        { "key": "Content-Type", "value": "audio/mpeg" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ]
}
